FROM gradle:9.2-jdk25-alpine

# Pin the dependency cache location explicitly so it matches the
# `gradle_cache` named volume in docker-compose.dev.yml.
ENV GRADLE_USER_HOME=/home/gradle/.gradle

WORKDIR /workspace

# Deliberately no COPY of build files or sources.
# compose bind-mounts the repo root onto /workspace at runtime, which would
# hide anything copied here. Source comes from the mount; downloaded
# dependencies live in GRADLE_USER_HOME, kept in the gradle_cache volume.

EXPOSE 3000

CMD ["gradle", "--no-daemon", ":services:account:bootRun"]
